# Application / Aplicação
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database / Base de dados (placeholders only / apenas placeholders)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/APP_DB
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (never real secrets / nunca segredos reais)
JWT_SECRET=change-me-in-local-env
SESSION_SECRET=change-me-in-local-env

# External APIs / APIs externas
STRIPE_API_KEY=sk_test_replace_me
SENTRY_DSN=https://example@o0.ingest.sentry.io/0
